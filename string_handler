#include <stdio.h>
#include <stdlib.h>


/* ================= STRCPY ================= */

void strcpy_string(char *str, char *str1)
{
    int i;

    for(i = 0; str[i] != '\0'; i++)
    {
        str1[i] = str[i];
    }

    str1[i] = '\0';

    printf("Copied String : %s\n", str1);
}


/* ================= STRCAT ================= */

void strconcat_string(char *src, char *dest)
{
    int length = 0;

    while(src[length] != '\0')
    {
        length++;
    }

    int i;

    for(i = 0; dest[i] != '\0'; i++)
    {
        src[length + i] = dest[i];
    }

    src[length + i] = '\0';

    printf("Concatenated String : %s\n", src);
}


/* ================= STRCMP ================= */

void stringcomp_string(char *src, char *dest)
{
    int position = 0;

    for(int i = 0; src[i] != '\0' || dest[i] != '\0'; i++)
    {
        if(src[i] != dest[i])
        {
            position = 1;
            break;
        }
    }

    if(position)
        printf("Strings are not equal\n");
    else
        printf("Strings are equal\n");
}


/* ================= STRCHR ================= */

void stringchr_string(char *src, char ch)
{
    for(int i = 0; src[i] != '\0'; i++)
    {
        if(src[i] == ch)
        {
            printf("Character '%c' found at position %d\n", ch, i);

            return;
        }
    }

    printf("Character not found\n");
}


