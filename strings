void convertlowercase()
{
    
     char *str;
    str=(char*)malloc(20*sizeof(char));
    fgets(str,20,stdin);
    int length=strlen(str);
    for(int i=0;i<length;i++)
    {
        if(str[i]>='A'&&str[i]<='Z')
        {
            str[i]+=32;
        }
    }
    printf("%s",str);
}
void convertuppercase()
{
    
     char *str;
    str=(char*)malloc(20*sizeof(char));
    fgets(str,20,stdin);
    int length=strlen(str);
    for(int i=0;i<length;i++)
    {
        if(str[i]>='a'&&str[i]<='z')
        {
            str[i]-=32;
        }
    }
    printf("%s",str);
}
void reverse()
{
    char *str;
    str=(char*)malloc(20*sizeof(char));
    fgets(str,20,stdin);
    int length=strlen(str);
    for(int i=0;i<length/2;i++)
    {
        
        char temp=str[length-i-1];
        str[length-i-1]=str[i];
        str[i]=temp;
    }
    printf("%s",str);
}
