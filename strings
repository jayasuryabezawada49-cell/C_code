void vowels()
{
    char *str;

    str = malloc(20 * sizeof(char));

    printf("Enter string: ");
    fgets(str, 20, stdin);

    int length = strlen(str);

    char vowels[] = "aeiouAEIOU";

    int countVowels = 0;
    int countConsonants = 0;

    for (int i = 0; i < length; i++)
    {
        int isVowel = 0;

        for (int j = 0; vowels[j] != '\0'; j++)
        {
            if (str[i] == vowels[j])
            {
                isVowel = 1;
                break;
            }
        }

        if (isVowel)
            countVowels++;
        else if ((str[i] >= 'a' && str[i] <= 'z') ||
                 (str[i] >= 'A' && str[i] <= 'Z'))
            countConsonants++;
    }

    printf("Vowels = %d\n", countVowels);
    printf("Consonants = %d\n", countConsonants);

    free(str);
}
void digits()
{
    char *str;
    str=(char*)malloc(20*sizeof(char));
    fgets(str,20,stdin);
    int length=strlen(str);
    int count=0;
    for(int i=0;i<length;i++)
    {
        if(str[i]>='0'&&str[i]<='9')
        {
            count++;
        }
    }
    printf("countdigits=%d",count);
}
